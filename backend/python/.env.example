# Python uses its own explicitly loaded environment. It does NOT read the Next.js .env.local.
BACKEND_ENV=local
BACKEND_AUTH_MODE=password

# Phase 1 password login: run sql/oracle/mvp_phase1.sql and app.mvp_phase1 first.
# Common initial password for the explicit account import only; never returned to the browser.
# Set a value of at least 8 characters locally, then remove it after a successful import.
STAFFING_MVP_DEFAULT_PASSWORD=
STAFFING_SESSION_HOURS=8

# Optional enterprise mode (BACKEND_AUTH_MODE=oidc); not required for password login.
# Only RS256 access tokens from this issuer are accepted; browser role headers grant nothing.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# Optional local API testing only: BACKEND_AUTH_MODE=local, with a random >=32-character token.
# This subject must still have active Oracle APP_USER_ROLES mappings. Never enabled in production.
BACKEND_LOCAL_TOKEN=
BACKEND_LOCAL_SUBJECT=

# Four-profile entrance using existing demo:d1 employee role mappings.
# Local only; signed per-browser sessions replace the fixed subject while enabled.
STAFFING_DEMO_PERSONAS_ENABLED=false

# Reuse approved Oracle connection values, with absolute wallet paths on each host.
DB_USER=AI_POD_STAFFING
DB_PASSWORD=
DB_TNS_ALIAS=
DB_WALLET_LOCATION=
DB_WALLET_PASSWORD=
DB_POOL_MIN=0
DB_POOL_MAX=2
DB_POOL_INCREMENT=1

OCI_CONFIG_FILE=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT
OCI_GENAI_ENDPOINT=
OCI_GENAI_COMPARTMENT_ID=
OCI_GENAI_MODEL_ID=
# Required for this adapter: confirmed LangChain OCI provider, e.g. generic, meta or cohere.
# Use generic only for a supported OpenAI-family model hosted in OCI; no OpenAI API key is used.
OCI_GENAI_PROVIDER=
OCI_TIMEOUT_SECONDS=30
OCI_MAX_OUTPUT_TOKENS=2048

# Phase 3: both this flag AND STAFFING_RUNTIME.agents_enabled='Y' must be enabled explicitly.
# Start the worker separately; starting Next.js or FastAPI never starts it.
STAFFING_WORKER_ENABLED=false
STAFFING_DECISIONS_ENABLED=false
STAFFING_POLICY_VERSION=staffing-v1-draft
STAFFING_POLL_SECONDS=5
STAFFING_LEASE_SECONDS=180
STAFFING_MAX_CANDIDATES=60
STAFFING_SEARCH_LIMIT=2000

# Telemetry must not export staffing evidence to a third-party service by default.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
# Captain decisions/assignments exist in phase 4 but are separately disabled above. No email sender.
