# Runtime data source. Use "oracle" for the Oracle Database 26ai-backed app.
STAFFING_DATA_SOURCE=oracle

# Legacy preview setting; ignored by authenticated routes while agentic integration is enabled.
STAFFING_AUTH_MODE=preview

# Oracle Database credentials. Never commit real values.
DB_USER=AI_POD_STAFFING
DB_PASSWORD=
DB_TNS_ALIAS=aimlcoesandbox_medium
DB_WALLET_LOCATION=C:/absolute/path/to/Wallet_AIMLCOESANDBOX
DB_WALLET_PASSWORD=

# Keep local pools small. The shared VM can use min=1 and max=4.
DB_POOL_MIN=0
DB_POOL_MAX=2
DB_POOL_INCREMENT=1

# OCI Generative AI writing assistance (server-side only). Authentication uses
# the OCI API signing key in the selected ~/.oci/config profile; no GenAI API
# key is required. The compartment must grant that identity permission to use
# Generative AI chat.
AI_REPHRASE_ENABLED=false
OCI_CONFIG_FILE=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT
OCI_GENAI_ENDPOINT=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com
OCI_GENAI_COMPARTMENT_ID=
OCI_GENAI_MODEL_ID=ocid1.generativeaimodel.oc1.us-chicago-1.amaaaaaask7dceyahekyujmz4evnwe3x7hwdl3z6pd7mfouqtmekmxudomjq
AI_REPHRASE_TIMEOUT_MS=15000

# Phase 4 agent integration. Keep both flags aligned; public flag requires a Next.js restart/rebuild.
STAFFING_AGENTIC_ENABLED=true
NEXT_PUBLIC_STAFFING_AGENTIC_ENABLED=true
STAFFING_BACKEND_URL=http://127.0.0.1:8015
# bearer: forwards a trusted login cookie/access token, verified by Python.
# local: development-only fixed identity, Next.js must bind to 127.0.0.1.
# password: email/password login with revocable Python sessions; works locally and on the VM.
STAFFING_BACKEND_AUTH_MODE=password
STAFFING_BACKEND_LOCAL_TOKEN=

# Optional local four-profile entrance. Set the same flag in backend/python/.env.
# Requires both servers on loopback and local auth; never enabled in production.
STAFFING_DEMO_PERSONAS_ENABLED=false

# Organization login (Authorization Code + PKCE). Server-only values; no NEXT_PUBLIC secrets.
# Register this origin + /api/auth/callback with your identity administrator.
STAFFING_APP_ORIGIN=http://127.0.0.1:3001
STAFFING_OIDC_AUTHORIZATION_URL=
STAFFING_OIDC_TOKEN_URL=
STAFFING_OIDC_CLIENT_ID=
STAFFING_OIDC_CLIENT_SECRET=
STAFFING_OIDC_SCOPE=openid
STAFFING_LOGIN_STATE_SECRET=
