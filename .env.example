# Runtime data source. Use "oracle" for the Oracle Database 26ai-backed app.
STAFFING_DATA_SOURCE=oracle

# The current application is a role-preview demo. OCI identity integration can
# replace this mode later without changing the database permission model.
STAFFING_AUTH_MODE=preview

# Oracle Database credentials. Never commit real values.
DB_USER=AI_POD_STAFFING
DB_PASSWORD=
DB_TNS_ALIAS=aimlcoesandbox_medium
DB_WALLET_LOCATION=C:/absolute/path/to/Wallet_AIMLCOESANDBOX
DB_WALLET_PASSWORD=

# Keep local pools small. The shared VM can use min=1 and max=4.
DB_POOL_MIN=0
DB_POOL_MAX=2
DB_POOL_INCREMENT=1
