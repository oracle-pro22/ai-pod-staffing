# Server-only configuration. Copy to .env.local; never use NEXT_PUBLIC_ for secrets.
AI_PROVIDER=oci
OCI_CONFIG_FILE=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..replace_me
OCI_GENAI_ENDPOINT=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com
OCI_MODEL_ID=openai.gpt-5.5
# native = signed /20231130/actions/chat. responses = signed /openai/v1/responses.
OCI_GENAI_API_FORMAT=native
# Required only with responses:
# OCI_GENAI_PROJECT_OCID=ocid1.generativeaiproject...
# Explicit offline testing only: set AI_PROVIDER=demo. Never falls back silently.
STAFFING_WORKBOOK_PATH=data/runtime/staffing.xlsx
APP_REVIEWER_NAME=Indranie B.

# start.sh launches both services; the supervisor runs inside Python.
FRONTEND_PORT=3001
BACKEND_PORT=8001
# Console verbosity for Python application logs. DEBUG includes routine API polls
# and failure code locations, but never model prompts, responses or credentials.
APP_LOG_LEVEL=INFO
# Optional for a deployed frontend origin; comma-separated, no trailing slash.
# APP_ALLOWED_ORIGINS=https://staffing.example.com
