# Runtime data source. Use "oracle" for the Oracle Database 26ai-backed app.
STAFFING_DATA_SOURCE=oracle

# The current application is a role-preview demo. OCI identity integration can
# replace this mode later without changing the database permission model.
STAFFING_AUTH_MODE=preview

# Oracle Database credentials. Never commit real values.
DB_USER=AI_POD_STAFFING
DB_PASSWORD=
DB_TNS_ALIAS=aimlcoesandbox_medium
DB_WALLET_LOCATION=C:/absolute/path/to/Wallet_AIMLCOESANDBOX
DB_WALLET_PASSWORD=

# Keep local pools small. The shared VM can use min=1 and max=4.
DB_POOL_MIN=0
DB_POOL_MAX=2
DB_POOL_INCREMENT=1

# OCI Generative AI writing assistance (server-side only). Authentication uses
# the OCI API signing key in the selected ~/.oci/config profile; no GenAI API
# key is required. The compartment must grant that identity permission to use
# Generative AI chat.
AI_REPHRASE_ENABLED=false
OCI_CONFIG_FILE=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT
OCI_GENAI_ENDPOINT=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com
OCI_GENAI_COMPARTMENT_ID=
OCI_GENAI_MODEL_ID=ocid1.generativeaimodel.oc1.us-chicago-1.amaaaaaask7dceyahekyujmz4evnwe3x7hwdl3z6pd7mfouqtmekmxudomjq
AI_REPHRASE_TIMEOUT_MS=15000
