        <mxCell id="mapping_note" value="Operational tables with no direct Excel sheet — DECISION, ALLOCATION, STATUS_HISTORY, EVIDENCE_SNAPSHOT and AUDIT_EVENT — persist capabilities already present in the Next.js UI and keep them separate from the customer-controlled catalogue." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=0;fontColor=#1F2937;" vertex="1" parent="1">
